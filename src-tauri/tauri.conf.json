{
  "$schema": "https://schema.tauri.app/config/2.11.0/",
  "productName": "AbyssReader",
  "version": "0.1.0",
  "identifier": "com.abyss.reader.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "墨阅",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "center": true,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/512x512.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
